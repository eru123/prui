{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "prui": [
        "../packages/prui/src/index.ts"
      ],
      "prui/*": [
        "../packages/prui/src/*/index.ts"
      ],
      "prui/app-shell": [
        "../packages/prui/src/app/app.tsx"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
